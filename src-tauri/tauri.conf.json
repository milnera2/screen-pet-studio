{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Pet Studio",
  "version": "0.1.0",
  "identifier": "com.screenpetstudio.app",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev -- --port 1420", "beforeBuildCommand": "npm run build" },
  "app": { "withGlobalTauri": false, "windows": [{ "label": "main", "title": "Screen Pet Studio", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 560, "decorations": false, "transparent": true, "resizable": true }] },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
